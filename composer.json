{
    "name": "cakedc/cakephp-oauth-server",
    "description": "OAuth 2.1 authorization server for CakePHP 5: sign in with your application's login, consent and connections pages, CIMD, dynamic registration, personal tokens. Built on cakedc/oauth-server.",
    "type": "cakephp-plugin",
    "license": "MIT",
    "keywords": ["cakephp", "oauth", "oauth2", "oauth-2.1", "authorization-server", "mcp"],
    "authors": [
        {"name": "Cake Development Corporation", "homepage": "https://www.cakedc.com"}
    ],
    "require": {
        "php": ">=8.2",
        "cakedc/oauth-server": "1.x-dev",
        "cakephp/authentication": "^3.3.6",
        "cakephp/cakephp": "^5.1.10",
        "cakephp/migrations": "^4.0 || ^5.0"
    },
    "require-dev": {
        "cakedc/auth": "^10.1 || ^11.0",
        "cakephp/authorization": "^3.0",
        "cakephp/cakephp-codesniffer": "^5.1",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.1 || ^13.0"
    },
    "suggest": {
        "cakedc/users": "Plug and play: users table, login, two-factor and RBAC rules are picked up automatically",
        "cakedc/auth": "RBAC rules can decide who may authorize which client",
        "cakephp/authorization": "The plugin's endpoints skip its authorization check by themselves"
    },
    "repositories": [
        {"type": "path", "url": "../oauth-server", "options": {"symlink": true}}
    ],
    "autoload": {
        "psr-4": {"CakeDC\\OAuthServer\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {
            "CakeDC\\OAuthServer\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/",
            "UsersTestApp\\": "tests/test_app_users/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --no-progress",
        "check": ["@test", "@cs-check", "@stan"]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
