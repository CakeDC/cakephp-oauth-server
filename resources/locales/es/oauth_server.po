msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: es\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Authorize {0}"
msgstr "Autorizar a {0}"

msgid "{0} wants to access {1}"
msgstr "{0} quiere acceder a {1}"

msgid "The request comes from {0}. Your answer is sent to {1}."
msgstr "La solicitud viene de {0}. Tu respuesta se envía a {1}."

msgid "This application registered itself; its name is not verified."
msgstr "Esta aplicación se registró sola; su nombre no está verificado."

msgid "Only continue if you just started this from an application on this computer: any program on this computer can use this address."
msgstr "Continúa solo si acabas de iniciar esto desde una aplicación de este equipo: cualquier programa de este equipo puede usar esta dirección."

msgid "An application on this computer"
msgstr "Una aplicación de este equipo"

msgid "It calls itself {0}. Anyone can choose that name."
msgstr "Se hace llamar {0}. Cualquiera puede elegir ese nombre."

msgid "You approved this application before. It is asked again because its identity cannot be confirmed: only continue if you started this yourself."
msgstr "Ya aprobaste esta aplicación antes. Se te vuelve a preguntar porque no se puede confirmar su identidad: continúa solo si iniciaste esto tú."

msgid "Signed in as {0}."
msgstr "Has iniciado sesión como {0}."

msgid "It will be able to:"
msgstr "Podrá:"

msgid "Stay connected until you revoke it."
msgstr "Seguir conectada hasta que la revoques."

msgid "Allow"
msgstr "Permitir"

msgid "Deny"
msgstr "Rechazar"

msgid "Authorization failed"
msgstr "La autorización falló"

msgid "The application sent a request that cannot be completed."
msgstr "La aplicación envió una solicitud que no se puede completar."

msgid "The application asked to send this answer to {0}. This server cannot confirm that {0} belongs to it: only continue if you trust it."
msgstr "La aplicación pidió enviar esta respuesta a {0}. Este servidor no puede confirmar que {0} pertenezca a esa aplicación: continúa solo si confías en {0}."

msgid "Continue to {0}"
msgstr "Continuar a {0}"

msgid "Connected applications"
msgstr "Aplicaciones conectadas"

msgid "Never"
msgstr "Nunca"

msgid "No application is connected."
msgstr "No hay ninguna aplicación conectada."

msgid "Application"
msgstr "Aplicación"

msgid "Access to"
msgstr "Acceso a"

msgid "Permissions"
msgstr "Permisos"

msgid "Connected"
msgstr "Conectada"

msgid "Last used"
msgstr "Último uso"

msgid "Revoke"
msgstr "Revocar"

msgid "Unverified: this application registered itself."
msgstr "Sin verificar: esta aplicación se registró sola."

msgid "{0} and an application on this computer"
msgstr "{0} y una aplicación de este equipo"

msgid "Personal access tokens"
msgstr "Tokens personales"

msgid "Copy your new token now. It will not be shown again:"
msgstr "Copia tu nuevo token ahora. No se volverá a mostrar:"

msgid "You have no personal access tokens."
msgstr "No tienes tokens personales."

msgid "Name"
msgstr "Nombre"

msgid "Resource"
msgstr "Recurso"

msgid "Expires"
msgstr "Vence"

msgid "Expires in (days, up to {0})"
msgstr "Vence en (días, hasta {0})"

msgid "Create token"
msgstr "Crear token"

msgid "The authorization service is not available right now. Try again later."
msgstr "El servicio de autorización no está disponible en este momento. Inténtalo de nuevo más tarde."
